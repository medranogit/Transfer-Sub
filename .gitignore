# Arquivos de video (nao versionar - sao dados de teste/uso real, nao codigo)
*.mkv
*.mp4
*.avi
*.mov
*.wmv
*.m4v
*.webm
*.flv
*.mpg
*.mpeg

# .ts tambem e extensao de video (MPEG transport stream), mas colide com
# codigo TypeScript (ui/src/**/*.ts) - por isso so ignoramos dentro das
# pastas de midia, nunca globalmente.
/Arquivos de video/**/*.ts

# Downloads parciais que podem cair nas pastas de midia
*.crdownload
*.part
*.tmp
*.download

# Log de transferencia gerado pelo app (dado de uso real, nao codigo)
transfer-log.json

